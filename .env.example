# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ==============================================================================
# Base URL for canonical links, sitemaps, OpenGraph metadata, schema.org
NEXT_PUBLIC_SITE_URL=https://mon-entreprise.fr

# Build output mode:
# - 'export' for 100% static SSG (Hostinger Shared, Netlify, Cloudflare Pages, GitHub Pages)
# - 'standalone' for Docker, Coolify, VPS Node.js server
# - Leave blank for default Next.js server runtime (Vercel, Node server)
NEXT_OUTPUT=standalone

# Google Analytics / Tag Manager (Optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Contact / Lead Form Webhook or API (Optional)
CONTACT_FORM_WEBHOOK_URL=
