# PayTech Senegal Payment Gateway (https://www.paytech.sn)
# Récupérer dans l’espace marchand PayTech : Paramètres > API & APN
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test # Utiliser 'test' pour le bac à sable et 'prod' en production réelle

# Umami — mesure d’audience auto-hébergée.
# Ces valeurs sont lues À L’EXÉCUTION par la route serveur GET /api/admin/analytics
# et par lib/umami.ts. Un simple redémarrage suffit à les prendre en compte.
UMAMI_URL=
UMAMI_WEBSITE_ID=
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_TIMEZONE=Africa/Dakar

# Contreparties publiques, figées dans le bundle au moment du build.
# Elles sont nécessaires au script de mesure chargé par src/app/layout.tsx :
# sans elles, aucune visite n’est envoyée, même si les variables ci-dessus sont
# renseignées. Les modifier dans Coolify exige donc un redéploiement.
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
